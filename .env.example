# The environment of the studio.
#
# The studio is configured by its environment: it names the gateway it
# calls, the broker it authenticates its callers against and the
# workspaces it may serve. Copy the file to `.env` and change the values.

# The environment of the process: production, development or test.
NODE_ENV=development

# The address and the port the studio listens on.
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8081

# The url the browser reaches the studio under. It is the redirect uri of
# the login and it has to be registered with the broker.
BRIDGE_PUBLIC_URL=http://localhost:8081

# The base url of the gateway. Every call to the data backend goes
# through it: the gateway signs the identity of the caller.
BRIDGE_GATEWAY_URL=http://localhost:8080

# The base url of the broker of the platform.
BRIDGE_HUB_URL=http://localhost:8082

# The client of the studio at the broker, and its secret when it has one.
BRIDGE_HUB_CLIENT_ID=bridge
BRIDGE_HUB_CLIENT_SECRET=
BRIDGE_HUB_SCOPE=openid profile email groups

# The workspaces the studio may serve, separated by commas. It is required
# in a production environment.
BRIDGE_WORKSPACES=

# The lifetime of a session of the studio, in seconds.
BRIDGE_SESSION_TTL_SECONDS=3600

# Whether the cookies of the studio carry the `Secure` attribute. It is
# `true` in a production environment.
BRIDGE_SECURE_COOKIES=false

# The key with which the identity of the gateway is verified: the public
# key of the deployment (the signature `v5`). It is required in a
# production environment.
#
# The symmetric format of the earlier releases (`v4`) is not understood:
# the gateway removed it in its `1.0` release, because its key was
# shared with the upstreams.
BRIDGE_GATEWAY_IDENTITY_PUBLIC_KEY=

# Whether a request that did not go through the gateway is refused. It is
# `true` in a production environment.
BRIDGE_REQUIRE_GATEWAY_IDENTITY=false

# Whether the workspace of the identity of the gateway has to be the
# workspace of the studio.
BRIDGE_BIND_GATEWAY_WORKSPACE=true

# Whether the studio answers the probes of the deployment.
BRIDGE_PROBES=true
