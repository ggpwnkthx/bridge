{
  "name": "bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bridge: the studio of the headless data backend. A client of the platform, behind the gateway.",
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "prestart": "bun run build",
    "start": "bun run src/main.ts",
    "predev": "bun run build",
    "dev": "bun --watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "bun test test/unit test/contract",
    "test:unit": "bun test test/unit",
    "test:contract": "bun test test/contract",
    "test:all": "bun test"
  },
  "dependencies": {
    "hono": "4.13.13",
    "jose": "6.2.12",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.3",
    "typescript": "5.9.3"
  }
}
